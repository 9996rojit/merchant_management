NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=merchant_db

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Replace both values with separate outputs from: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-this-with-a-generated-base64-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-this-with-a-different-generated-base64-secret
JWT_REFRESH_EXPIRES_IN=7d